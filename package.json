{
  "name": "markfill",
  "version": "0.1.0",
  "description": "MarkFill — 24/7 xStock desk that only buys or LPs when on-chain price is honest vs NYSE",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/band.test.ts",
    "check-secrets": "node scripts/check-no-secrets.mjs",
    "sweep": "tsx scripts/sweep-custodial.ts --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pythnetwork/pyth-solana-receiver": "^0.13.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
